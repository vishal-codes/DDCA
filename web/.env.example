# Browser-visible development key. Configure allowed sites in Protomaps.
NEXT_PUBLIC_PROTOMAPS_API_KEY=

# Free hosted summaries. Without its key, original excerpts remain available.
GOVERNMENT_DISCOVERY_PROVIDER=openrouter

# Server-only OpenRouter key. No local model or paid credits needed.
OPENROUTER_API_KEY=
OPENROUTER_DISCOVERY_MODEL=openrouter/free

# Server-only search key. Searches only reviewed government domains.
TAVILY_API_KEY=

# Server-only key used when the provider is openai.
OPENAI_API_KEY=
OPENAI_DISCOVERY_MODEL=gpt-5.4-mini

# Optional Nominatim-compatible endpoint for location search.
GEOCODER_URL=https://nominatim.openstreetmap.org

# Optional reviewed domain overrides by ISO country code.
# GOVERNMENT_DOMAINS_JSON={"xx":["official-government-domain.example"]}
